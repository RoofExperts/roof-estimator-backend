# Required
DATABASE_URL=postgresql://user:pass@host:5432/dbname
SECRET_KEY=generate-a-random-secret

# Vision provider configuration
# VISION_PROVIDER controls which AI vendor is used for plan analysis.
# - "anthropic" (default): use Claude Opus 4.7 via ANTHROPIC_API_KEY
# - "openai": use GPT-4o via OPENAI_API_KEY (legacy fallback)
VISION_PROVIDER=anthropic

# Anthropic (required when VISION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
VISION_MODEL_ANTHROPIC=claude-opus-4-7

# OpenAI (required when VISION_PROVIDER=openai, kept for fallback/A-B testing)
OPENAI_API_KEY=sk-...
VISION_MODEL_OPENAI=gpt-4o

# AWS S3 (for plan file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Spec reader configuration (separate from vision provider)
# Sonnet 4.6 is recommended: cheaper than Opus, plenty smart for text parsing
SPEC_PROVIDER=anthropic
SPEC_MODEL_ANTHROPIC=claude-sonnet-4-6
SPEC_MODEL_OPENAI=gpt-4o-mini

# Vector extraction (Track C)
# When true, attempts vector geometry extraction in parallel with vision.
# Set to false to fall back to vision-only behavior (Track A).
VECTOR_EXTRACTION_ENABLED=true

# Discrepancy threshold (percentage). When vector and vision disagree by more
# than this percentage on the same measurement, the discrepancy is logged
# and surfaced for review. 15 is a reasonable default.
VECTOR_DISCREPANCY_THRESHOLD_PCT=15
